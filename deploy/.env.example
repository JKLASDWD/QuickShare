# Copy to .env on the deployment server; fill fresh random secrets.
# SERVER_IP is required only for IP deployment.
SERVER_IP=203.0.113.10
# Optional for docker-compose.selfsigned.yml; HTTPS/WSS public port.
TLS_PORT=8989
# Optional for direct/port-mapped deployment: full externally reachable ws:// or wss:// URL.
# LIVEKIT_WS_URL=ws://share.example.com:17880
# Required by the existing-Nginx deployment; a bare DNS name without scheme.
SHARE_DOMAIN=share.example.com
LIVEKIT_API_SECRET=
AUTH_TOKEN=
