# Copy to .env on the deployment server; see docs/服务端部署指南.md.
# Secrets must remain empty in this example. Generate two independent random values.
LIVEKIT_CONFIG=./livekit.local.yaml
SHARE_DOMAIN=share.example.com
# Required only for IP deployment; documentation address, replace before use.
SERVER_IP=203.0.113.10
# Public HTTPS/WSS port for docker-compose.selfsigned.yml.
TLS_PORT=8989
# Optional override for direct IP/port-mapped signaling only.
# LIVEKIT_WS_URL=ws://203.0.113.10:7880
LIVEKIT_API_SECRET=
AUTH_TOKEN=
