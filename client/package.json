{
  "name": "screenshare-client",
  "productName": "QuickShare",
  "version": "1.0.0",
  "description": "快捷屏幕共享客户端（共享/观看双角色，LiveKit SFU）",
  "main": "main.js",
  "author": "internal",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "node scripts/fetch-vendor.mjs && node scripts/gen-icon.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "npm run build:native && electron-builder --win",
    "dist:portable": "npm run build:native && electron-builder --win portable",
    "build:native": "node scripts/build-native.mjs"
  },
  "build": {
    "afterPack": "scripts/verify-package.cjs",
    "appId": "com.internal.quickshare",
    "productName": "QuickShare",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "certificate-policy.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "config.example.json",
      "package.json",
      "process-audio.js",
      "room-id.js",
      "diagnostics.js",
      "native/bin/process-audio.exe"
    ],
    "asarUnpack": ["native/bin/process-audio.exe"],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "QuickShare-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "QuickShare-Setup-${version}.exe",
      "shortcutName": "QuickShare"
    },
    "extraResources": [
      {
        "from": "native/bin/process-audio.exe",
        "to": "native/process-audio.exe"
      },
      {
        "from": "../LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../licenses",
        "to": "licenses/upstream"
      },
      {
        "from": "renderer/vendor/licenses",
        "to": "licenses/vendor"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "livekit-client": "^2.22.3"
  },
  "dependencies": {}
}
